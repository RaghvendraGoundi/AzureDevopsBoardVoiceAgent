# Which realtime provider to use: openai | azure
VOICE_PROVIDER=openai

# --- OpenAI Realtime ---
OPENAI_API_KEY=
# gpt-realtime-2.1 (best tool use) or gpt-realtime-2.1-mini (cheaper)
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# --- Azure OpenAI Realtime ---
# e.g. https://my-resource.openai.azure.com
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# Name of your gpt-realtime-2.x deployment
AZURE_OPENAI_REALTIME_DEPLOYMENT=gpt-realtime-2

# Voice used for assistant speech (marin or cedar recommended)
REALTIME_VOICE=marin

# minimal | low | medium | high | xhigh. "low" is the recommended start for voice.
REALTIME_REASONING_EFFORT=low

# Microphone / noise handling
# far_field for laptop or room mics, near_field for headsets.
NOISE_REDUCTION=far_field
# How the end of your turn is detected:
#   semantic (default) - judges from your words whether you've finished, so mid-sentence pauses are OK.
#   server             - ends the turn after VAD_SILENCE_MS of silence.
TURN_DETECTION=semantic
# semantic only: low (take your time), medium, high (answer fastest) or auto.
VAD_EAGERNESS=low
# Stricter threshold used while the assistant is talking, so a cough is less likely to cut it off.
VAD_THRESHOLD_WHILE_SPEAKING=0.9
# server only: 0.3-0.95 sensitivity, and the silence (ms) that ends your turn.
VAD_THRESHOLD=0.7
VAD_SILENCE_MS=800

# User-speech transcription. Defaults: gpt-transcribe (OpenAI), gpt-4o-mini-transcribe (Azure).
# REALTIME_TRANSCRIBE_MODEL=

# GPT-Live (the "GPT-Live" engine; OpenAI only). Board work is handed to a backend model.
# OPENAI_LIVE_MODEL=gpt-live-1
# Backend model GPT-Live hands harder questions to, and its reasoning effort.
LIVE_BACKEND_MODEL=gpt-6-luna
LIVE_REASONING_EFFORT=low
LIVE_VOICE=marin

# Board: "emulated" (local demo project, no Azure needed) or "azure" (real Azure DevOps).
BOARD_PROVIDER=emulated
# Azure DevOps (BOARD_PROVIDER=azure). The team defaults to "<project> Team".
# AZURE_DEVOPS_ORG=your-org
# AZURE_DEVOPS_PROJECT=Your Project
# AZURE_DEVOPS_TEAM=
# Tokens come from getAzureDevOpsCredential() in src/lib/devops/azure/auth.ts
# (plug your Entra ID sign-in in there). For a quick local test you can set a
# PAT with Work Items (Read & write) and Project and Team (Read) scopes:
# AZURE_DEVOPS_PAT=

# Emulated board: who "me" is
BOARD_CURRENT_USER=Demo User
