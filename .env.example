# =============================================================================
#  DevOps Voice: configuration
# =============================================================================
#  Copy to .env.local (git-ignored) and fill in what you need:
#
#      cp .env.example .env.local
#
#  Only section 1 is needed to start: the defaults use the emulated board and
#  run without sign-in. Lines starting with "#" are optional; the value shown
#  is the default. Never commit real keys or tokens.
# =============================================================================


# -----------------------------------------------------------------------------
#  1. Voice models (required)
# -----------------------------------------------------------------------------
#  openai = OpenAI API  ·  azure = Azure AI Foundry (Azure OpenAI)
VOICE_PROVIDER=openai

#  GPT-Live can run on a different provider. Default: same as VOICE_PROVIDER.
# LIVE_PROVIDER=openai

#  ---- OpenAI (VOICE_PROVIDER=openai) ----
OPENAI_API_KEY=
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1        # or gpt-realtime-2.1-mini (cheaper)
# OPENAI_LIVE_MODEL=gpt-live-1

#  ---- Azure AI Foundry (VOICE_PROVIDER=azure) ----
# AZURE_OPENAI_ENDPOINT=https://my-resource.openai.azure.com
# AZURE_OPENAI_REALTIME_DEPLOYMENT=gpt-realtime-2
# AZURE_OPENAI_LIVE_DEPLOYMENT=gpt-live-1
#
#  How the server signs in to Foundry:
#    managed-identity (default when no key is set): needs the role
#      "Cognitive Services OpenAI User" on the resource; uses `az login` locally.
#    api-key: set AZURE_OPENAI_API_KEY.
# AZURE_AUTH=managed-identity
# AZURE_OPENAI_API_KEY=
# AZURE_CLIENT_ID=                              # user-assigned managed identity only
# AZURE_LIVE_SESSIONS_URL=                      # default: <endpoint>/openai/v1/live/sessions


# -----------------------------------------------------------------------------
#  2. Voice behaviour (optional)
# -----------------------------------------------------------------------------
#  Default voices; people can pick their own in the app.
# REALTIME_VOICE=marin
# LIVE_VOICE=marin

#  Reasoning effort: minimal | low | medium | high | xhigh
# REALTIME_REASONING_EFFORT=low

#  GPT-Live hands board work to this model (a deployment name on Foundry).
# LIVE_BACKEND_MODEL=gpt-6-luna
# LIVE_REASONING_EFFORT=low

#  Speech-to-text for the on-screen transcript.
#  Default: gpt-transcribe (OpenAI), gpt-4o-mini-transcribe (Foundry).
# REALTIME_TRANSCRIBE_MODEL=

#  Microphone: far_field (laptop or room mic) | near_field (headset)
# NOISE_REDUCTION=far_field

#  When your turn ends:
#    semantic = judges from your words, so mid-sentence pauses are fine
#    server   = after VAD_SILENCE_MS of silence
# TURN_DETECTION=semantic
# VAD_EAGERNESS=low                             # semantic: low | medium | high | auto
# VAD_THRESHOLD=0.7                             # server: sensitivity 0.3–0.95
# VAD_SILENCE_MS=800                            # server: silence that ends your turn
# VAD_THRESHOLD_WHILE_SPEAKING=0.9              # stricter while the assistant talks


# -----------------------------------------------------------------------------
#  3. Azure DevOps board
# -----------------------------------------------------------------------------
#  emulated = local demo project (no Azure needed)  ·  azure = real Azure DevOps
BOARD_PROVIDER=emulated

#  ---- Real Azure DevOps (BOARD_PROVIDER=azure) ----
# AZURE_DEVOPS_ORG=your-org
# AZURE_DEVOPS_PROJECT=Your Project
# AZURE_DEVOPS_TEAM=                            # default: "<project> Team"
#
#  With sign-in (section 4) the board acts as the signed-in user. Without it,
#  for local testing only: a PAT with Work Items (Read & write) and
#  Project and Team (Read).
# AZURE_DEVOPS_PAT=

#  ---- Emulated board ----
# BOARD_CURRENT_USER=Demo User                  # who "me" is


# -----------------------------------------------------------------------------
#  4. Sign-in with Microsoft Entra ID (optional)
# -----------------------------------------------------------------------------
#  Set all four to require sign-in. Register this redirect URI in the app
#  registration: http://localhost:3000/api/auth/callback/microsoft-entra-id
# AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=
# AUTH_MICROSOFT_ENTRA_ID_ID=                   # Application (client) ID
# AUTH_MICROSOFT_ENTRA_ID_SECRET=               # client secret value
# AUTH_SECRET=                                  # random; e.g. openssl rand -base64 33
# AUTH_URL=https://voice.example.com            # public URL, when not on localhost


# -----------------------------------------------------------------------------
#  5. Roles (optional)
# -----------------------------------------------------------------------------
#  Always admins (comma separated). Admins see everyone's items and promote
#  others at /admin; everyone else sees and changes only their own items.
# ADMIN_EMAIL=you@company.com

#  Without sign-in, the local user is an admin. Set to "user" to try the user view.
# LOCAL_ROLE=


# -----------------------------------------------------------------------------
#  6. Database: PostgreSQL (optional; local files when unset)
# -----------------------------------------------------------------------------
#  Option A: a connection string (e.g. local Docker Postgres)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/devopsvoice
#
#  Option B: Azure Database for PostgreSQL with managed identity
# PGHOST=my-server.postgres.database.azure.com
# PGDATABASE=devopsvoice
# PGUSER=my-app-identity                        # the identity's Postgres role
# PG_AUTH=managed-identity
# PGPORT=5432
# PGPASSWORD=                                   # only without managed identity
# PGSSLMODE=                                    # "disable" for a local server only
#
# PG_POOL_MAX=10
# DB_AUTO_MIGRATE=true                          # false: run `npm run db:migrate` on deploy
# RETENTION_DAYS=90                             # used by `npm run db:purge`


# -----------------------------------------------------------------------------
#  7. Observability (optional)
# -----------------------------------------------------------------------------
#  OpenTelemetry traces to Azure Monitor / Application Insights.
# APPLICATIONINSIGHTS_CONNECTION_STRING=


# -----------------------------------------------------------------------------
#  8. Development only
# -----------------------------------------------------------------------------
#  Slows every board call, to try the "still working" experience.
#  Ignored in production.
# DEBUG_TOOL_DELAY_MS=6000
