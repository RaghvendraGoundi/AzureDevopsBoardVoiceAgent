{
  "name": "voice-devops-agent",
  "version": "0.1.0",
  "description": "A voice-first assistant for Azure DevOps Boards: talk to your sprint, with every change previewed and confirmed.",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm test",
    "board:reset": "node scripts/reset-board.mjs",
    "voice:audio": "node scripts/voice-test/make-audio.mjs",
    "design:capture": "node scripts/voice-test/make-audio.mjs design-tour && node scripts/voice-test/capture.mjs"
  },
  "dependencies": {
    "lucide-react": "1.57.0",
    "next": "^15.5.4",
    "next-auth": "5.0.0-beta.32",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
